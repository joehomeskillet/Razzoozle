{
  "name": "razzoozle",
  "version": "3.0.0",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm -r --parallel dev",
    "dev:web": "dotenv -e .env -- pnpm --filter web dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel run start",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "lint": "pnpm -r --parallel run types && pnpm exec oxlint",
    "test": "pnpm -r --if-present run test",
    "verify": "pnpm tokens:gate && pnpm -r run types && pnpm exec oxlint && pnpm -r --if-present run test",
    "format": "pnpm -r --parallel run format",
    "format:fix": "pnpm -r --parallel run format:fix",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "ci:policy": "node scripts/check-ci-policy.mjs",
    "i18n:check": "i18n-check -l packages/web/src/locales -s de -f i18next",
    "i18n:report": "i18n-check -l packages/web/src/locales -s de -f i18next -o unused,undefined -u packages/web/src",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:doc": "node scripts/generate-tokens-doc.mjs",
    "tokens:sync": "node scripts/sync-figma-tokens.mjs",
    "tokens:validate": "node scripts/lint-design-tokens.mjs",
    "tokens:hex-lint": "node scripts/ast-grep-tokens.mjs",
    "tokens:wasm": "node scripts/wasm-token-codemod.mjs",
    "tokens:morph": "node scripts/ast-morph-tailwind.mjs",
    "tokens:neural": "node scripts/validate-viewport-pixels.mjs",
    "tokens:ai-audit": "node scripts/lint-governance-rules.mjs",
    "tokens:daemon": "node scripts/refactor-tokens.mjs",
    "tokens:agents-sync": "node scripts/sync-agent-rules.mjs",
    "tokens:gate": "node scripts/design-gate.mjs",
    "tokens:gate:fix": "node scripts/design-gate.mjs --fix",
    "tokens:fix": "node scripts/lint-design-tokens.mjs --fix",
    "g:component": "node scripts/generate-component.mjs",
    "g:console": "node scripts/generate-component.mjs --domain console",
    "g:question": "node scripts/generate-component.mjs --domain question",
    "g:display": "node scripts/generate-component.mjs --domain display",
    "g:player": "node scripts/generate-component.mjs --domain player",
    "g:menu": "node scripts/generate-component.mjs --domain menu",
    "check-version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "latest",
    "@types/node": "^26.1.0",
    "dotenv-cli": "^11.0.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "style-dictionary": "^5.5.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
