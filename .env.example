# Razzoozle Server Configuration
#
# This file documents all environment variables read by the Rust server.
# Copy this file to .env and fill in appropriate values for your deployment.
#
# SECURITY WARNING: This file contains EXAMPLE VALUES ONLY.
# Never commit actual secrets, passwords, API keys, or real database URLs to version control.
# Use environment variables or the *_FILE pattern for sensitive values.
#
# Many sensitive variables support a *_FILE pattern: set VARIABLE_NAME_FILE=/path/to/secret/file
# to read the value from a file instead of directly. The file's trailing newline (if present) is removed.
# If both VARIABLE_NAME and VARIABLE_NAME_FILE are set, an error is returned (fail-safe).

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────

# Database connection string (PostgreSQL). Required for migrations and runtime.
# Supports: DATABASE_URL_FILE
# Example: postgresql://user:password@localhost:5432/razzoozle
# Required: Yes
DATABASE_URL=postgresql://change-me:change-me@localhost:5432/razzoozle

# ─────────────────────────────────────────────────────────────────────────────
# SERVER & NETWORK
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server port. Server binds to 0.0.0.0 (Docker port forwarding safe).
# Default: 3020
# Required: No
PORT=3020

# Absolute or relative path to configuration directory (config/ folder).
# If unset, defaults to ./config/ relative to server working directory.
# Default: config
# Required: No
CONFIG_PATH=

# Absolute or relative path to web distribution (compiled frontend assets).
# Fallback paths: /app/web (prod), packages/web/dist (dev).
# Required: No (has built-in fallbacks)
WEB_DIST=

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY & AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

# Encryption key for user AI provider keys (OpenAI, etc.) at rest in database.
# Users can set their own external AI provider keys; they are encrypted with this passphrase
# using PostgreSQL pgp_sym_encrypt. Required if AI key management is used.
# Supports: AI_KEY_ENCRYPTION_KEY_FILE
# Required: Yes (if users set external AI keys)
AI_KEY_ENCRYPTION_KEY=<your-strong-encryption-key-at-least-20-chars>

# Optional satellite/external-service authentication token.
# If set, enables satellite authentication for incoming connections.
# Supports: SATELLITE_TOKEN_FILE
# Required: No
SATELLITE_TOKEN=

# Manager display password for controlling the game from a separate terminal.
# If unset, defaults to "PASSWORD" (sentinel value; fails auth).
# Override via DATABASE MANAGER_PASSWORD table, or set this env var.
# Supports: MANAGER_PASSWORD_FILE
# Required: No (has default)
MANAGER_PASSWORD=

# Bootstrap admin user for initial database setup (empty database only).
# When database has 0 users and both BOOTSTRAP_ADMIN_USER and BOOTSTRAP_ADMIN_PASSWORD
# are set, an admin account is created. Idempotent: no-op if users already exist.
# Required: No
BOOTSTRAP_ADMIN_USER=

# Bootstrap admin password (pairs with BOOTSTRAP_ADMIN_USER).
# Supports: BOOTSTRAP_ADMIN_PASSWORD_FILE (recommended for production)
# Required: No (but BOOTSTRAP_ADMIN_USER must also be set for bootstrap to work)
BOOTSTRAP_ADMIN_PASSWORD=

# Development API key for protected endpoints in dev mode.
# Only used if RAZZOOLE_DEV=1.
# Supports: DEV_API_KEY_FILE
# Required: No
DEV_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT & DEBUGGING
# ─────────────────────────────────────────────────────────────────────────────

# Enable development mode (set to "1" to activate).
# Enables dev API endpoints and relaxes some security checks.
# Default: unset (production mode)
# Required: No
RAZZOOLE_DEV=

# Enable simulation mode for testing player bots in manager commands.
# When set to "1", allows the /sim_players manager command to add bot players.
# Default: unset (disabled)
# Required: No
RAHOOT_SIM_MODE=

# ─────────────────────────────────────────────────────────────────────────────
# EXTERNAL SERVICES: ComfyUI
# ─────────────────────────────────────────────────────────────────────────────

# ComfyUI HTTP endpoint URL for image generation (txt2img and img2img).
# Used by the media/image generation pipeline to submit prompts.
# Default: http://127.0.0.1:8188
# Required: No (uses default if unset)
COMFYUI_URL=http://127.0.0.1:8188

# Path to ComfyUI txt2img workflow JSON file (text-to-image).
# Path is relative to server working directory.
# Default: ./workflows/txt2img-zimage-turbo.json
# Required: No (uses default if unset)
COMFYUI_WORKFLOW=./workflows/txt2img-zimage-turbo.json

# Path to ComfyUI img2img workflow JSON file (image-to-image / sketch2img).
# Path is relative to server working directory.
# Default: ./workflows/sketch2img-zimage-turbo.json
# Required: No (uses default if unset)
COMFYUI_IMG2IMG_WORKFLOW=./workflows/sketch2img-zimage-turbo.json
